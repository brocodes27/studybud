# Supabase project URL (same as VITE_SUPABASE_URL in the web app's env)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key (Supabase Dashboard -> Project Settings -> API).
# KEEP THIS SECRET — it bypasses RLS. Only put it on the trusted grader box.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Identifier for this physical grader machine. Must match the Device ID
# entered in the Grader Console (/teacher/grader) on the laptop.
GRADER_DEVICE_ID=grader-local-1

# Optional: camera capture command template. '{out}' is replaced with the
# output JPEG path. Defaults: Linux -> fswebcam, macOS -> imagesnap.
# Examples:
#   CAPTURE_CMD=fswebcam -r 1920x1080 --no-banner --jpeg 90 {out}
#   CAPTURE_CMD=imagesnap -w 1 {out}
#   CAPTURE_CMD=libcamera-still -n -o {out}
# CAPTURE_CMD=
